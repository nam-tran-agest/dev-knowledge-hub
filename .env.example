# ==============================================================================
# DEV KNOWLEDGE HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (MANDATORY - Core Auth, Database & Realtime)
# Get credentials at: https://app.supabase.com/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. STEAM WEB API (OPTIONAL - Gaming Telemetry, In-Game Status & Live Widget)
# Get free API key at: https://steamcommunity.com/dev/apikey
# ------------------------------------------------------------------------------
STEAM_WEB_API_KEY=your-steam-web-api-key

# ------------------------------------------------------------------------------
# 3. SPOTIFY DEVELOPER API (OPTIONAL - Music Stream, Now Playing & Game Mood Sync)
# Create App at: https://developer.spotify.com/dashboard
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback
